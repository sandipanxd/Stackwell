NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/stackwell

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

REDIS_URL=redis://localhost:6379

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional — set these once you've created the corresponding Products/Prices
# in your Stripe test-mode dashboard. Checkout for a plan without its price ID
# configured returns a clear 503, not a confusing Stripe SDK error.
# STRIPE_PRICE_PRO=price_replace_me
# STRIPE_PRICE_ENTERPRISE=price_replace_me
